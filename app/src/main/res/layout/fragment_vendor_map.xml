<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- Google Map Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".fragments.VendorMapFragment" />

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:tint="@color/colorSecondary" />

            <EditText
                android:id="@+id/etSearchVendors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Search vendors near you..."
                android:textColorHint="@color/colorSecondary"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnCurrentLocation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_my_location"
                app:tint="@color/colorPrimary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Vendor Category Filter -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:layout_marginHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutCategoryFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text="All"
                app:chipBackgroundColor="@color/colorPrimary"
                app:chipIcon="@drawable/ic_vendor"
                app:chipIconTint="@color/colorAccent" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPhotographer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Photographer"
                app:chipIcon="@drawable/ic_photo_camera"
                app:chipIconTint="@color/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCaterer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Caterer"
                app:chipIcon="@drawable/ic_restaurant"
                app:chipIconTint="@color/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDecorator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Decorator"
                app:chipIcon="@drawable/ic_decoration"
                app:chipIconTint="@color/colorPrimary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFlorist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Florist"
                app:chipIcon="@drawable/ic_local_florist"
                app:chipIconTint="@color/colorPrimary" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Bottom Sheet for Vendor Details -->
    <include
        android:id="@+id/bottomSheetVendorDetails"
        layout="@layout/bottom_sheet_vendor_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBarLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Map Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:orientation="vertical">

        <!-- Toggle Map Type -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabToggleMapType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_layers"
            app:backgroundTint="@color/colorAccent"
            app:fabSize="mini"
            app:tint="@color/colorPrimary" />

        <!-- Filter Vendors -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFilterVendors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_filter_list"
            app:backgroundTint="@color/colorPrimary"
            app:fabSize="mini"
            app:tint="@color/colorAccent" />

    </LinearLayout>

    <!-- Vendor Count Badge -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVendorCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">

        <TextView
            android:id="@+id/tvVendorCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textColor="@color/colorAccent"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="12 vendors found" />

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
